<UserControl x:Class="Makara.Desktop.Views.FieldMappingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1120" HorizontalAlignment="Left" Margin="0,0,16,16">

            <!-- 步骤条 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,24" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource MkPrimary}">
                        <Path Data="{StaticResource IconCheckCircle}" Stroke="{DynamicResource MkPrimaryForeground}"
                              StrokeThickness="1.6" Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="选择数据源" FontSize="14" Foreground="{DynamicResource MkTextPrimary}" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="Medium"/>
                </StackPanel>
                <Rectangle Width="48" Height="1" Fill="{DynamicResource MkPrimary}" Margin="12,0"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource MkSurface}" BorderBrush="{DynamicResource MkPrimary}" BorderThickness="1">
                        <TextBlock Text="2" FontSize="12" Foreground="{DynamicResource MkPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="字段映射" FontSize="14" Foreground="{DynamicResource MkTextPrimary}" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="Medium"/>
                </StackPanel>
                <Rectangle Width="48" Height="1" Fill="{DynamicResource MkBorder}" Margin="12,0"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource MkSurface}" BorderBrush="{DynamicResource MkBorder}" BorderThickness="1">
                        <TextBlock Text="3" FontSize="12" Foreground="{DynamicResource MkTextTertiary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="数据集生成" FontSize="14" Foreground="{DynamicResource MkTextTertiary}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- 页头 -->
            <DockPanel Margin="0,0,0,20">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding PreviewCommand}" Padding="14,7" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconEye}" Stroke="{DynamicResource MkTextSecondary}" StrokeThickness="1.6" Stretch="Uniform" Width="13" Height="13" VerticalAlignment="Center"/>
                            <TextBlock Text="预览样本" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SaveMappingCommand}" Padding="14,7">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconSave}" Stroke="{DynamicResource MkPrimaryForeground}" StrokeThickness="1.6" Stretch="Uniform" Width="13" Height="13" VerticalAlignment="Center"/>
                            <TextBlock Text="保存映射" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="字段映射" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="将源数据字段映射到训练格式目标字段，构建标准化的微调数据集。" FontSize="13"
                               Foreground="{DynamicResource MkTextSecondary}" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>

            <!-- 映射区：源字段 | 箭头 | 目标字段 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 源字段 -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16">
                    <StackPanel>
                        <TextBlock FontSize="14" FontWeight="Medium" Foreground="{DynamicResource MkTextPrimary}" Margin="0,0,0,12">
                            <Run Text="源字段"/>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding SourceFields}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource MkSurface}" BorderBrush="{DynamicResource MkBorder}" BorderThickness="1"
                                            CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                        <Grid>
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontFamily="Consolas" Foreground="{DynamicResource MkTextPrimary}" VerticalAlignment="Center"/>
                                            <Border HorizontalAlignment="Right" Background="{DynamicResource MkSurface2}" CornerRadius="4" Padding="8,2">
                                                <TextBlock Text="{Binding Type}" FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource MkTextSecondary}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 箭头 -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Path Data="{StaticResource IconArrowRight}" Stroke="{DynamicResource MkTextTertiary}" StrokeThickness="1.6" Stretch="Uniform" Width="18" Height="18" Margin="0,3"/>
                    <Path Data="{StaticResource IconArrowRight}" Stroke="{DynamicResource MkTextTertiary}" StrokeThickness="1.6" Stretch="Uniform" Width="18" Height="18" Margin="0,3"/>
                    <Path Data="{StaticResource IconArrowRight}" Stroke="{DynamicResource MkTextTertiary}" StrokeThickness="1.6" Stretch="Uniform" Width="18" Height="18" Margin="0,3"/>
                    <Path Data="{StaticResource IconArrowRight}" Stroke="{DynamicResource MkTextTertiary}" StrokeThickness="1.6" Stretch="Uniform" Width="18" Height="18" Margin="0,3"/>
                    <Path Data="{StaticResource IconArrowRight}" Stroke="{DynamicResource MkTextTertiary}" StrokeThickness="1.6" Stretch="Uniform" Width="18" Height="18" Margin="0,3"/>
                    <Path Data="{StaticResource IconArrowRight}" Stroke="{DynamicResource MkTextTertiary}" StrokeThickness="1.6" Stretch="Uniform" Width="18" Height="18" Margin="0,3"/>
                </StackPanel>

                <!-- 目标字段 -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                    <StackPanel>
                        <TextBlock FontSize="14" FontWeight="Medium" Foreground="{DynamicResource MkTextPrimary}" Margin="0,0,0,12">
                            <Run Text="训练格式目标字段"/>
                        </TextBlock>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="instruction" FontSize="13" FontFamily="Consolas" Foreground="{DynamicResource MkTextPrimary}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding SourceOptions}" SelectedItem="{Binding MapInstruction, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="input" FontSize="13" FontFamily="Consolas" Foreground="{DynamicResource MkTextPrimary}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding SourceOptions}" SelectedItem="{Binding MapInput, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="output" FontSize="13" FontFamily="Consolas" Foreground="{DynamicResource MkTextPrimary}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding SourceOptions}" SelectedItem="{Binding MapOutput, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="history" FontSize="13" FontFamily="Consolas" Foreground="{DynamicResource MkTextPrimary}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding SourceOptions}" SelectedItem="{Binding MapHistory, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="system" FontSize="13" FontFamily="Consolas" Foreground="{DynamicResource MkTextPrimary}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding SourceOptions}" SelectedItem="{Binding MapSystem, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="__index__" FontSize="13" FontFamily="Consolas" Foreground="{DynamicResource MkTextPrimary}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding SourceOptions}" SelectedItem="{Binding MapIndex, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 预览 -->
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock FontSize="14" FontWeight="Medium" Foreground="{DynamicResource MkTextPrimary}" Margin="0,0,0,12">
                        <Run Text="训练样本预览"/>
                    </TextBlock>
                    <Border Background="{DynamicResource MkSurface}" CornerRadius="8" Padding="14" BorderBrush="{DynamicResource MkBorder}" BorderThickness="1">
                        <TextBlock Text="{Binding PreviewJson}" FontFamily="Consolas" FontSize="13"
                                   Foreground="{DynamicResource MkTextPrimary}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 上一步 / 下一步 -->
            <Grid Margin="0,20,0,0">
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding PrevCommand}" Padding="16,8" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconArrowLeft}" Stroke="{DynamicResource MkTextSecondary}" StrokeThickness="1.6" Stretch="Uniform" Width="13" Height="13" VerticalAlignment="Center"/>
                        <TextBlock Text="上一步" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding NextCommand}" Padding="16,8" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="下一步" FontSize="12" VerticalAlignment="Center"/>
                        <Path Data="{StaticResource IconArrowRight}" Stroke="{DynamicResource MkPrimaryForeground}" StrokeThickness="1.6" Stretch="Uniform" Width="13" Height="13" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource MkPrimary}" Margin="2,10,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
