<UserControl x:Class="Makara.Desktop.Views.ServersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ 工具栏 ============ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Command="{Binding AddCommand}" Padding="14,7" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPlus}" Stroke="{DynamicResource MkPrimaryForeground}"
                              StrokeThickness="2" Stretch="Uniform" Width="13" Height="13" VerticalAlignment="Center"/>
                        <TextBlock Text="添加服务端" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding CheckAllCommand}" Padding="14,7">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconRefresh}" Stroke="{DynamicResource MkTextSecondary}"
                              StrokeThickness="1.6" Stretch="Uniform" Width="13" Height="13" VerticalAlignment="Center"/>
                        <TextBlock Text="刷新" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="服务端" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="管理多个 Makara 服务端连接，一键切换" FontSize="12" Foreground="{DynamicResource MkTextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- ============ 列表 + 详情 ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- 服务端列表 -->
            <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="8">
                <ListView ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}"
                          Background="Transparent" BorderThickness="0">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource MkBackground}" BorderBrush="{DynamicResource MkBorder}"
                                    BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="4,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                                            Background="{DynamicResource MkPrimarySoft}" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconServer}" Stroke="{DynamicResource MkPrimary}"
                                              StrokeThickness="1.6" Stretch="Uniform" Margin="8"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/>
                                            <Border Style="{StaticResource Badge}" Margin="8,0,0,0"
                                                    Background="{DynamicResource MkPrimarySoft}" Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="默认" FontSize="10" Foreground="{DynamicResource MkPrimary}"/>
                                            </Border>
                                            <Border Style="{StaticResource Badge}" Margin="4,0,0,0"
                                                    Background="{DynamicResource MkPrimary}" Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="当前" FontSize="10" Foreground="{DynamicResource MkPrimaryForeground}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Address}" FontSize="11"
                                                   Foreground="{DynamicResource MkTextTertiary}" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource MkTextTertiary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource MkSuccess}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <Button Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SecondaryButton}" FontSize="11" Padding="10,4" Margin="8,0,0,0">
                                            <TextBlock Text="连接" FontSize="11"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <!-- 编辑详情 -->
            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="基本信息" Margin="0,0,0,16"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="名称" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="地址" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding EditAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource HintText}" Text="http://... 或 https://..." Margin="0,0,0,12"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="描述" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                    <CheckBox IsChecked="{Binding EditIsDefault}" Content="设为默认服务端" Margin="0,0,0,20"/>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="认证信息" Margin="0,0,0,16"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Token" Margin="0,0,0,4"/>
                    <PasswordBox Margin="0,0,0,20"/>

                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource MkPrimary}"
                               Margin="0,0,0,12" TextWrapping="Wrap"/>

                    <UniformGrid Columns="2">
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding TestCommand}" Padding="12,7" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconZap}" Stroke="{DynamicResource MkTextSecondary}"
                                      StrokeThickness="1.6" Stretch="Uniform" Width="13" Height="13" VerticalAlignment="Center"/>
                                <TextBlock Text="测试连接" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding SetDefaultCommand}" Padding="12,7" Margin="6,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconStar}" Stroke="{DynamicResource MkTextSecondary}"
                                      StrokeThickness="1.6" Stretch="Uniform" Width="13" Height="13" VerticalAlignment="Center"/>
                                <TextBlock Text="设为默认" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SaveCommand}" Padding="12,7" Margin="0,8,6,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconSave}" Stroke="{DynamicResource MkPrimaryForeground}"
                                      StrokeThickness="1.6" Stretch="Uniform" Width="13" Height="13" VerticalAlignment="Center"/>
                                <TextBlock Text="保存" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" Padding="12,7" Margin="6,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconTrash}" Stroke="White"
                                      StrokeThickness="1.6" Stretch="Uniform" Width="13" Height="13" VerticalAlignment="Center"/>
                                <TextBlock Text="删除" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ 底部连接状态 ============ -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,10" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding LatencyText}" FontSize="12"
                           Foreground="{DynamicResource MkTextSecondary}"/>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource MkSuccess}"/>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ConnectionText}" FontSize="12" Margin="10,0,0,0"
                               Foreground="{DynamicResource MkTextSecondary}" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
