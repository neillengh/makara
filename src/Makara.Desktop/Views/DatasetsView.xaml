<UserControl x:Class="Makara.Desktop.Views.DatasetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ 页头 ============ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding LoadCommand}" Padding="14,7" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconRefresh}" Stroke="{DynamicResource MkTextSecondary}"
                              StrokeThickness="1.6" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="刷新" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="数据集" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="管理、预览与导出训练数据集" FontSize="12" Foreground="{DynamicResource MkTextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- ============ 统计卡 ============ -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,12,0">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Width="36" Height="36" CornerRadius="7"
                            Background="{DynamicResource MkPrimarySoft}">
                        <Path Data="{StaticResource IconTable}" Stroke="{DynamicResource MkPrimary}"
                              StrokeThickness="1.6" Stretch="Uniform" Margin="8"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="数据集总数" FontSize="11" Foreground="{DynamicResource MkTextSecondary}"/>
                        <TextBlock Text="{Binding TotalDatasets}" FontSize="22" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,12,0">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Width="36" Height="36" CornerRadius="7"
                            Background="{DynamicResource MkSuccessSoft}">
                        <Path Data="{StaticResource IconFiles}" Stroke="{DynamicResource MkSuccess}"
                              StrokeThickness="1.6" Stretch="Uniform" Margin="8"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="样本总量" FontSize="11" Foreground="{DynamicResource MkTextSecondary}"/>
                        <TextBlock Text="{Binding TotalSamples, StringFormat={}{0:N0}}" FontSize="22" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,12,0">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Width="36" Height="36" CornerRadius="7"
                            Background="{DynamicResource MkWarningSoft}">
                        <Path Data="{StaticResource IconBarChart}" Stroke="{DynamicResource MkWarning}"
                              StrokeThickness="1.6" Stretch="Uniform" Margin="8"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="平均质量分" FontSize="11" Foreground="{DynamicResource MkTextSecondary}"/>
                        <TextBlock Text="{Binding AvgQuality}" FontSize="22" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="16">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Width="36" Height="36" CornerRadius="7"
                            Background="{DynamicResource MkInfoSoft}">
                        <Path Data="{StaticResource IconTrendingUp}" Stroke="{DynamicResource MkInfo}"
                              StrokeThickness="1.6" Stretch="Uniform" Margin="8"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="今日新增" FontSize="11" Foreground="{DynamicResource MkTextSecondary}"/>
                        <TextBlock Text="{Binding TodayNew}" FontSize="22" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </UniformGrid>

        <!-- ============ 列表 + 样本预览 ============ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- 数据集列表 -->
            <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="8">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="8,4,8,8">
                        <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{DynamicResource MkPrimary}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="数据集列表" Style="{StaticResource SectionTitle}"/>
                    </DockPanel>
                    <ListView ItemsSource="{Binding Datasets}" SelectedItem="{Binding SelectedDataset}"
                              Background="Transparent" BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="名称" Width="170">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium"
                                                       TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="格式" Width="90" DisplayMemberBinding="{Binding FormatText}"/>
                                <GridViewColumn Header="样本数" Width="80">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SampleCount, StringFormat={}{0:N0}}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="创建时间" Width="90" DisplayMemberBinding="{Binding CreatedAtText}"/>
                                <GridViewColumn Header="质量分" Width="60">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding QualityScore}" Foreground="{Binding QualityBrush}" FontWeight="Medium"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="状态" Width="70">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding StatusText}" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="操作" Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource DangerButton}" FontSize="11" Padding="10,4"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconTrash}" Stroke="White" StrokeThickness="1.8"
                                                          Stretch="Uniform" Width="11" Height="11" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>

            <!-- 样本预览 -->
            <Border Style="{StaticResource Card}" Padding="16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconEye}" Stroke="{DynamicResource MkPrimary}"
                                  StrokeThickness="1.6" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="样本预览" Style="{StaticResource SectionTitle}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock FontSize="11" Foreground="{DynamicResource MkTextSecondary}" Margin="0,4,0,0">
                            <Run Text="当前选中："/><Run Text="{Binding SelectedDataset.Name, Mode=OneWay, FallbackValue=—}"/>
                        </TextBlock>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Samples}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource MkBackground}" BorderBrush="{DynamicResource MkBorder}"
                                            BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding Fields}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,0,0,6">
                                                            <TextBlock Text="{Binding Field}" FontSize="10" FontWeight="Medium"
                                                                       Foreground="{DynamicResource MkPrimary}"/>
                                                            <TextBlock Text="{Binding Value}" FontSize="12" TextWrapping="Wrap"
                                                                       Margin="0,2,0,0"
                                                                       Foreground="{DynamicResource MkTextPrimary}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
