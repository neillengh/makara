<UserControl x:Class="Makara.Desktop.Views.WorkflowTemplatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:Makara.Desktop.Converters"
             mc:Ignorable="d">
    <UserControl.Resources>
        <conv:PageEqualityConverter x:Key="PageEq"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1120" HorizontalAlignment="Left" Margin="0,0,16,16">

            <!-- 页头：标题 + 搜索 -->
            <DockPanel Margin="0,0,0,20">
                <TextBlock Text="工作流模板" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Grid DockPanel.Dock="Right" Width="240" Margin="0,0,0,0">
                    <Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource MkTextTertiary}"
                          StrokeThickness="1.6" Stretch="Uniform" Width="14" Height="14"
                          HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="32,7,10,7" FontSize="13"/>
                </Grid>
            </DockPanel>

            <!-- 分类筛选 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <RadioButton Style="{StaticResource OptionButton}" GroupName="wtfilter" Content="全部"
                             IsChecked="{Binding ActiveFilter, Converter={StaticResource PageEq}, ConverterParameter=全部}"
                             Command="{Binding SetFilterCommand}" CommandParameter="全部" Margin="0,0,8,0"/>
                <RadioButton Style="{StaticResource OptionButton}" GroupName="wtfilter" Content="数据同步"
                             IsChecked="{Binding ActiveFilter, Converter={StaticResource PageEq}, ConverterParameter=数据同步}"
                             Command="{Binding SetFilterCommand}" CommandParameter="数据同步" Margin="0,0,8,0"/>
                <RadioButton Style="{StaticResource OptionButton}" GroupName="wtfilter" Content="模型训练"
                             IsChecked="{Binding ActiveFilter, Converter={StaticResource PageEq}, ConverterParameter=模型训练}"
                             Command="{Binding SetFilterCommand}" CommandParameter="模型训练" Margin="0,0,8,0"/>
                <RadioButton Style="{StaticResource OptionButton}" GroupName="wtfilter" Content="自动化部署"
                             IsChecked="{Binding ActiveFilter, Converter={StaticResource PageEq}, ConverterParameter=自动化部署}"
                             Command="{Binding SetFilterCommand}" CommandParameter="自动化部署" Margin="0,0,8,0"/>
                <RadioButton Style="{StaticResource OptionButton}" GroupName="wtfilter" Content="多租户"
                             IsChecked="{Binding ActiveFilter, Converter={StaticResource PageEq}, ConverterParameter=多租户}"
                             Command="{Binding SetFilterCommand}" CommandParameter="多租户"/>
            </StackPanel>

            <!-- 模板卡片网格 -->
            <ItemsControl ItemsSource="{Binding Filtered}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Width="340" Padding="20" Margin="0,0,16,16">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <Border DockPanel.Dock="Right" Background="{DynamicResource MkPrimarySoft}"
                                            CornerRadius="9" Padding="8,2">
                                        <TextBlock Text="{Binding Category}" FontSize="12"
                                                   Foreground="{DynamicResource MkPrimary}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{DynamicResource MkTextPrimary}" VerticalAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </DockPanel>

                                <TextBlock Text="{Binding Description}" FontSize="13"
                                           Foreground="{DynamicResource MkTextSecondary}" TextWrapping="Wrap"
                                           Margin="0,0,0,14" Height="78" />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Path Data="{StaticResource IconCpu}" Stroke="{DynamicResource MkTextTertiary}"
                                          StrokeThickness="1.5" Stretch="Uniform" Width="13" Height="13"/>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource MkTextTertiary}" Margin="6,0,0,0">
                                        <Run Text="包含 "/>
                                        <Run Text="{Binding NodeCount}" FontWeight="SemiBold"/>
                                        <Run Text=" 个节点"/>
                                    </TextBlock>
                                </StackPanel>

                                <Button Content="一键套用" Padding="0,9"
                                        Command="{Binding DataContext.UseTemplateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource MkPrimary}" Margin="2,8,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
