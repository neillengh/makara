<UserControl x:Class="Makara.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ KPI 卡片 ============ -->
        <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,16">
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,12,0">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Width="40" Height="40" CornerRadius="8"
                            Background="{DynamicResource MkPrimarySoft}" VerticalAlignment="Top">
                        <Path Data="{StaticResource IconBranch}" Stroke="{DynamicResource MkPrimary}"
                              StrokeThickness="1.6" Stretch="Uniform" Margin="8"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="工作流数量" FontSize="13" Foreground="{DynamicResource MkTextSecondary}"/>
                        <TextBlock Text="{Binding KpiWorkflows}" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,12,0">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Width="40" Height="40" CornerRadius="8"
                            Background="{DynamicResource MkSuccessSoft}" VerticalAlignment="Top">
                        <Path Data="{StaticResource IconTable}" Stroke="{DynamicResource MkSuccess}"
                              StrokeThickness="1.6" Stretch="Uniform" Margin="8"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="数据集" FontSize="13" Foreground="{DynamicResource MkTextSecondary}"/>
                        <TextBlock Text="{Binding KpiDatasets}" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,12,0">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Width="40" Height="40" CornerRadius="8"
                            Background="{DynamicResource MkInfoSoft}" VerticalAlignment="Top">
                        <Path Data="{StaticResource IconCheckCircle}" Stroke="{DynamicResource MkInfo}"
                              StrokeThickness="1.6" Stretch="Uniform" Margin="8"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="运行成功" FontSize="13" Foreground="{DynamicResource MkTextSecondary}"/>
                        <TextBlock Text="{Binding KpiSuccess}" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="20">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Width="40" Height="40" CornerRadius="8"
                            Background="{DynamicResource MkWarningSoft}" VerticalAlignment="Top">
                        <Path Data="{StaticResource IconServer}" Stroke="{DynamicResource MkWarning}"
                              StrokeThickness="1.6" Stretch="Uniform" Margin="8"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="服务端状态" FontSize="13" Foreground="{DynamicResource MkTextSecondary}"/>
                        <TextBlock Text="{Binding ServerStatus}" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground" Value="{DynamicResource MkError}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ServerStatus}" Value="在线">
                                            <Setter Property="Foreground" Value="{DynamicResource MkSuccess}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>
        </UniformGrid>

        <!-- ============ 趋势图 + 最近执行 ============ -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <!-- 近 7 天运行趋势 -->
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,12,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="30" Height="30"
                                Command="{Binding LoadCommand}" ToolTip="刷新">
                            <Path Data="{StaticResource IconRefresh}" Stroke="{DynamicResource MkTextSecondary}"
                                  StrokeThickness="1.6" Stretch="Uniform" Width="14" Height="14"/>
                        </Button>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="近 7 天运行趋势"/>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" FontSize="11"
                               Foreground="{DynamicResource MkTextTertiary}" TextTrimming="CharacterEllipsis"/>
                    <Viewbox Stretch="Uniform">
                        <Grid Width="700" Height="230">
                            <Canvas Width="700" Height="200">
                                <!-- 横向网格线 -->
                                <Line X1="36" Y1="12" X2="664" Y2="12" Stroke="{DynamicResource MkBorder}" StrokeThickness="1"/>
                                <Line X1="36" Y1="59" X2="664" Y2="59" Stroke="{DynamicResource MkBorder}" StrokeThickness="1"/>
                                <Line X1="36" Y1="106" X2="664" Y2="106" Stroke="{DynamicResource MkBorder}" StrokeThickness="1"/>
                                <Line X1="36" Y1="153" X2="664" Y2="153" Stroke="{DynamicResource MkBorder}" StrokeThickness="1"/>
                                <Line X1="36" Y1="188" X2="664" Y2="188" Stroke="{DynamicResource MkBorder}" StrokeThickness="1"/>
                                <!-- 折线区域 -->
                                <Polygon Points="{Binding TrendFill}" Fill="{DynamicResource MkPrimarySoft}"/>
                                <Polyline Points="{Binding TrendPoints}" Stroke="{DynamicResource MkPrimary}"
                                          StrokeThickness="2.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <!-- 数据点 -->
                                <ItemsControl ItemsSource="{Binding ChartPoints}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas Width="700" Height="200"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Ellipse Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}"
                                                     Width="8" Height="8" StrokeThickness="2"
                                                     Stroke="{DynamicResource MkPrimary}" Fill="{DynamicResource MkSurface}"
                                                     ToolTip="{Binding Tooltip}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Canvas>
                            <!-- X 轴日期 -->
                            <ItemsControl Margin="36,204,36,0" VerticalAlignment="Top"
                                          ItemsSource="{Binding TrendLabels}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="11" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource MkTextTertiary}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Viewbox>
                </DockPanel>
            </Border>

            <!-- 最近执行记录 -->
            <Border Style="{StaticResource Card}" Padding="20">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="最近执行记录" Margin="0,0,0,12"/>
                    <ListView ItemsSource="{Binding RecentRuns}" Background="Transparent" BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource MkBackground}" BorderBrush="{DynamicResource MkBorder}"
                                        BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock VerticalAlignment="Center" FontSize="11" Margin="0,0,10,0"
                                                           Foreground="{DynamicResource MkTextTertiary}"
                                                           Text="{Binding DurationText}"/>
                                                <Border>
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                                            <Setter Property="Background" Value="{DynamicResource MkInfoSoft}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="success">
                                                                    <Setter Property="Background" Value="{DynamicResource MkSuccessSoft}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="failed">
                                                                    <Setter Property="Background" Value="{DynamicResource MkErrorSoft}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="cancelled">
                                                                    <Setter Property="Background" Value="{DynamicResource MkWarningSoft}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="11" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                <Setter Property="Foreground" Value="{DynamicResource MkInfo}"/>
                                                                <Setter Property="Text" Value="运行中"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="success">
                                                                        <Setter Property="Foreground" Value="{DynamicResource MkSuccess}"/>
                                                                        <Setter Property="Text" Value="成功"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="failed">
                                                                        <Setter Property="Foreground" Value="{DynamicResource MkError}"/>
                                                                        <Setter Property="Text" Value="失败"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="cancelled">
                                                                        <Setter Property="Foreground" Value="{DynamicResource MkWarning}"/>
                                                                        <Setter Property="Text" Value="取消"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="{Binding WorkflowName}" FontSize="13" FontWeight="Medium"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding StartTime, StringFormat=yyyy-MM-dd HH:mm}" FontSize="11"
                                                       Foreground="{DynamicResource MkTextTertiary}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ============ 快捷入口 ============ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 最近工作流 -->
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,12,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="最近工作流" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding RecentWorkflows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource MkBackground}" BorderBrush="{DynamicResource MkBorder}"
                                        BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="32" Height="32" CornerRadius="6"
                                                Background="{DynamicResource MkPrimarySoft}">
                                            <Path Data="{StaticResource IconBranch}" Stroke="{DynamicResource MkPrimary}"
                                                  StrokeThickness="1.6" Stretch="Uniform" Margin="7"/>
                                        </Border>
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium"/>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource MkTextTertiary}" Margin="0,2,0,0">
                                                <Run Text="{Binding Nodes.Count, Mode=OneWay}"/><Run Text=" 个节点"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- 最近数据集 -->
            <Border Style="{StaticResource Card}" Padding="20">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="最近数据集" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding RecentDatasets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource MkBackground}" BorderBrush="{DynamicResource MkBorder}"
                                        BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="32" Height="32" CornerRadius="6"
                                                Background="{DynamicResource MkSuccessSoft}">
                                            <Path Data="{StaticResource IconTable}" Stroke="{DynamicResource MkSuccess}"
                                                  StrokeThickness="1.6" Stretch="Uniform" Margin="7"/>
                                        </Border>
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium"/>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource MkTextTertiary}" Margin="0,2,0,0">
                                                <Run Text="{Binding SampleCount, StringFormat={}{0:N0}, Mode=OneWay}"/><Run Text=" 条样本"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
