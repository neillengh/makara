<UserControl x:Class="Makara.Desktop.Views.WorkflowCanvasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Makara.Desktop.Models"
             xmlns:vm="clr-namespace:Makara.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BgPrimaryBrush}"
             d:DataContext="{d:DesignInstance vm:WorkflowCanvasViewModel}"
             Focusable="True"
             KeyDown="UserControl_KeyDown">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <DrawingBrush x:Key="CanvasGridBrush" TileMode="Tile"
                      Viewport="0,0,24,24" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#0D1B2A">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,24,24"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#1A2A4A">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="12,12" RadiusX="1" RadiusY="1"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource BgSecondaryBrush}"
                Padding="16,10" CornerRadius="0,0,8,8" Margin="0,0,0,8">
            <DockPanel>
                <Button Content="← 返回" Click="BackButton_Click"
                        DockPanel.Dock="Left" Padding="12,6" Margin="0,0,16,0"/>
                <TextBlock Text="{Binding WorkflowName}" FontSize="16" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,20,0"/>
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource AccentSecondaryBrush}"
                           VerticalAlignment="Center" FontSize="13"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="保存" Command="{Binding SaveCommand}"
                            Padding="16,6" Margin="0,0,8,0"/>
                    <Button Content="▶ 运行" Command="{Binding RunCommand}"
                            Padding="16,6"
                            Background="{StaticResource AccentSecondaryBrush}"
                            Foreground="#1A1A2E"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Node palette -->
            <Border Grid.Column="0" Background="{StaticResource BgSecondaryBrush}"
                    Margin="0,0,8,0" CornerRadius="8">
                <DockPanel>
                    <TextBlock Text="节点面板" DockPanel.Dock="Top" Margin="16,12"
                               FontSize="14" FontWeight="SemiBold"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                        <ItemsControl ItemsSource="{x:Static models:NodeTemplate.All}" Margin="8,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BgCardBrush}"
                                            CornerRadius="6" Padding="10,8" Margin="0,2"
                                            MouseLeftButtonDown="PaletteItem_MouseLeftButtonDown"
                                            Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icon}"
                                                       FontSize="16" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="13" Margin="8,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Canvas -->
            <Border Grid.Column="1" Background="{StaticResource BgSecondaryBrush}"
                    CornerRadius="8" ClipToBounds="True">
                <ScrollViewer x:Name="CanvasScroll"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              AllowDrop="True"
                              DragOver="Canvas_DragOver"
                              Drop="Canvas_Drop"
                              Background="{StaticResource BgPrimaryBrush}">
                    <Grid x:Name="CanvasGrid" Width="3000" Height="2000"
                          Background="{StaticResource CanvasGridBrush}"
                          MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                          MouseMove="Canvas_MouseMove">

                        <!-- Edge layer -->
                        <ItemsControl ItemsSource="{Binding CanvasEdges}"
                                      IsHitTestVisible="True">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas Width="3000" Height="2000"
                                            Background="Transparent"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Path Data="{Binding PathData}"
                                          Stroke="{StaticResource AccentSecondaryBrush}"
                                          StrokeThickness="2"
                                          MouseLeftButtonDown="Edge_MouseLeftButtonDown"
                                          Cursor="Hand"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Temporary connection line -->
                        <Path Data="{Binding TempConnectionPath}"
                              Stroke="{StaticResource AccentPrimaryBrush}"
                              StrokeThickness="2" StrokeDashArray="4,3"
                              IsHitTestVisible="False"/>

                        <!-- Node layer -->
                        <ItemsControl ItemsSource="{Binding CanvasNodes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas Width="3000" Height="2000"
                                            Background="Transparent"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="180" Height="56">
                                        <!-- Node body -->
                                        <Border x:Name="NodeBorder"
                                                CornerRadius="8" BorderThickness="2"
                                                Background="{StaticResource BgCardBrush}"
                                                BorderBrush="{StaticResource BorderPrimaryBrush}"
                                                MouseLeftButtonDown="Node_MouseLeftButtonDown"
                                                MouseMove="Node_MouseMove"
                                                MouseLeftButtonUp="Node_MouseLeftButtonUp"
                                                Cursor="SizeAll">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="BorderBrush"
                                                                    Value="{StaticResource AccentSecondaryBrush}"/>
                                                            <Setter Property="Background"
                                                                    Value="#1A4A6A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                                            <Setter Property="BorderBrush"
                                                                    Value="{StaticResource AccentPrimaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal" Margin="14,0">
                                                <TextBlock Text="{Binding Icon}" FontSize="18"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Label}" FontSize="13"
                                                           Margin="10,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Input port (left) -->
                                        <Ellipse Width="14" Height="14"
                                                 Fill="{StaticResource AccentSecondaryBrush}"
                                                 Stroke="{StaticResource BgPrimaryBrush}"
                                                 StrokeThickness="2"
                                                 HorizontalAlignment="Left" VerticalAlignment="Center"
                                                 Margin="-7,0,0,0"
                                                 MouseLeftButtonDown="InputPort_MouseLeftButtonDown"
                                                 Cursor="Hand"
                                                 ToolTip="输入端口"/>

                                        <!-- Output port (right) -->
                                        <Ellipse Width="14" Height="14"
                                                 Fill="{StaticResource AccentSecondaryBrush}"
                                                 Stroke="{StaticResource BgPrimaryBrush}"
                                                 StrokeThickness="2"
                                                 HorizontalAlignment="Right" VerticalAlignment="Center"
                                                 Margin="0,0,-7,0"
                                                 MouseLeftButtonDown="OutputPort_MouseLeftButtonDown"
                                                 Cursor="Hand"
                                                 ToolTip="输出端口（拖拽到目标节点）"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
