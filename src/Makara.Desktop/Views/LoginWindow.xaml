<Window x:Class="Makara.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Makara.Desktop.ViewModels"
        Title="Makara · 登录" Width="440" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MkBackground}" FontFamily="Microsoft YaHei UI">

    <Grid>
        <Border Width="400" VerticalAlignment="Center" Margin="0,40"
                Style="{StaticResource Card}" Padding="34,30">
            <StackPanel>
                <!-- 品牌 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource MkPrimarySoft}">
                        <Path Data="{StaticResource IconBranch}" Stroke="{DynamicResource MkPrimary}"
                              StrokeThickness="1.8" Stretch="Uniform" Margin="6"/>
                    </Border>
                    <TextBlock Text="Makara" FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource MkTextPrimary}" Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="数据 · 模型 · 融合微调" FontSize="12"
                           Foreground="{DynamicResource MkTextSecondary}" HorizontalAlignment="Center"
                           Margin="0,0,0,26"/>

                <!-- 服务端地址 -->
                <TextBlock Text="服务端地址" FontSize="13" Foreground="{DynamicResource MkTextSecondary}" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,16">
                    <Path Data="{StaticResource IconServer}" Stroke="{DynamicResource MkTextTertiary}"
                          StrokeThickness="1.6" Stretch="Uniform" Width="16" Height="16"
                          HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBox Text="{Binding ServerAddress, UpdateSourceTrigger=PropertyChanged}"
                             Height="42" Padding="38,0,12,0" VerticalContentAlignment="Center"
                             FontSize="14" ToolTip="例如 https://makara.example.com"/>
                </Grid>

                <!-- 用户名 -->
                <TextBlock Text="用户名" FontSize="13" Foreground="{DynamicResource MkTextSecondary}" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,16">
                    <Path Data="{StaticResource IconUser}" Stroke="{DynamicResource MkTextTertiary}"
                          StrokeThickness="1.6" Stretch="Uniform" Width="16" Height="16"
                          HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             Height="42" Padding="38,0,12,0" VerticalContentAlignment="Center"
                             FontSize="14" ToolTip="例如 admin"/>
                </Grid>

                <!-- 密码 -->
                <TextBlock Text="密码" FontSize="13" Foreground="{DynamicResource MkTextSecondary}" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,16">
                    <Path Data="{StaticResource IconLock}" Stroke="{DynamicResource MkTextTertiary}"
                          StrokeThickness="1.6" Stretch="Uniform" Width="16" Height="16"
                          HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <PasswordBox x:Name="PwdBox" Height="42" Padding="38,0,12,0"
                                 VerticalContentAlignment="Center" FontSize="14"/>
                </Grid>

                <!-- 记住我 / 忘记密码 -->
                <Grid Margin="0,0,0,18">
                    <CheckBox IsChecked="{Binding RememberMe}" HorizontalAlignment="Left"
                              VerticalAlignment="Center" Content="记住我"/>
                    <Button Command="{Binding ForgotPasswordCommand}" HorizontalAlignment="Right"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Foreground="{DynamicResource MkPrimary}" FontSize="13">
                        <TextBlock Text="忘记密码？"/>
                    </Button>
                </Grid>

                <!-- 登录按钮 -->
                <Button Content="登  录" Height="42" FontSize="15" FontWeight="SemiBold"
                        Click="OnLoginClick"/>

                <!-- 错误提示 -->
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource MkError}" FontSize="12"
                           TextWrapping="Wrap" Margin="0,10,0,0" MinHeight="0"/>

                <!-- 页脚 -->
                <StackPanel Margin="0,22,0,0" HorizontalAlignment="Center">
                    <TextBlock Text="v0.1.0 MVP" FontSize="11" Foreground="{DynamicResource MkTextTertiary}"
                               FontFamily="Consolas"/>
                    <TextBlock Text="© 2026 Makara. All rights reserved." FontSize="10"
                               Foreground="{DynamicResource MkTextTertiary}" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
