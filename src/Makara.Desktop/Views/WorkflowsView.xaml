<UserControl x:Class="Makara.Desktop.Views.WorkflowsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="{StaticResource BgCardBrush}" Padding="20,12" CornerRadius="0,0,8,8" Margin="0,0,0,12">
            <DockPanel>
                <TextBlock Text="工作流管理" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AccentSecondaryBrush}"
                           VerticalAlignment="Center" Margin="20,0,0,0" FontSize="13"/>
                <Button Content="刷新" Command="{Binding LoadCommand}" DockPanel.Dock="Right"
                        HorizontalAlignment="Right" Padding="16,6"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- 工作流列表 -->
            <Border Grid.Column="0" Background="{StaticResource BgCardBrush}" CornerRadius="8" Margin="0,0,8,0">
                <DockPanel>
                    <TextBlock Text="已有工作流" DockPanel.Dock="Top" Margin="16,12" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <ListView ItemsSource="{Binding Workflows}" SelectedItem="{Binding SelectedWorkflow}"
                              Background="Transparent" BorderThickness="0" Margin="8">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgSecondaryBrush}" CornerRadius="6" Padding="12,10" Margin="0,2">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Orientation="Horizontal">
                                            <Button Content="编辑画布" Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}" FontSize="11" Padding="10,4" Margin="0,0,4,0"/>
                                            <Button Content="运行" Command="{Binding DataContext.RunCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}" FontSize="11" Padding="10,4" Margin="0,0,4,0"
                                                    Background="#00D9FF" Foreground="#1A1A2E"/>
                                            <Button Content="删除" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}" FontSize="11" Padding="10,4" Background="#E94560"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource AccentSecondaryBrush}"/>
                                                <TextBlock Text=" · " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding CronExpression}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </DockPanel>
            </Border>

            <!-- 新建工作流表单 -->
            <Border Grid.Column="1" Background="{StaticResource BgCardBrush}" CornerRadius="8">
                <StackPanel Margin="20">
                    <TextBlock Text="新建工作流" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16"/>

                    <TextBlock Text="名称" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                    <TextBlock Text="描述" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,12" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50"/>

                    <TextBlock Text="Cron 表达式（可选）" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewCronExpression, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                    <TextBlock Text="例: 0 2 * * * (每天凌晨2点)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16"/>

                    <Button Content="创建" Command="{Binding CreateCommand}" Padding="24,8" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
