<Window x:Class="Makara.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Makara.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="Makara · 摩羯" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A2E">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧导航栏 -->
        <Border Grid.Column="0" Background="#16213E" CornerRadius="0">
            <StackPanel Margin="0,20,0,0">
                <TextBlock Text="Makara" FontSize="24" FontWeight="Bold" Foreground="#E94560"
                           HorizontalAlignment="Center" Margin="0,0,0,30"/>
                <Button Content="工作流" Command="{Binding NavigateCommand}" CommandParameter="workflows"
                        Style="{StaticResource NavButtonStyle}" Margin="10,5"/>
                <Button Content="数据源" Command="{Binding NavigateCommand}" CommandParameter="datasources"
                        Style="{StaticResource NavButtonStyle}" Margin="10,5"/>
                <Button Content="数据集" Command="{Binding NavigateCommand}" CommandParameter="datasets"
                        Style="{StaticResource NavButtonStyle}" Margin="10,5"/>
                <Button Content="执行记录" Command="{Binding NavigateCommand}" CommandParameter="runs"
                        Style="{StaticResource NavButtonStyle}" Margin="10,5"/>
                <Button Content="设置" Command="{Binding NavigateCommand}" CommandParameter="settings"
                        Style="{StaticResource NavButtonStyle}" Margin="10,5"/>
            </StackPanel>
        </Border>

        <!-- 右侧主内容 -->
        <Grid Grid.Column="1" Margin="20">
            <ContentControl Content="{Binding CurrentPage}"/>
        </Grid>
    </Grid>

    <Window.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A0A0B0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="Transparent" CornerRadius="5" Padding="15,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A1A2E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
</Window>
