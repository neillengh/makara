<Window x:Class="Makara.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Makara.Desktop.ViewModels"
        xmlns:conv="clr-namespace:Makara.Desktop.Converters"
        mc:Ignorable="d"
        Title="Makara · 摩羯" Height="760" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MkBackground}"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <conv:PageEqualityConverter x:Key="PageEq"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== 左侧导航栏 ==================== -->
        <Border Grid.Column="0" Grid.RowSpan="2" Background="{DynamicResource MkSurface}"
                BorderBrush="{DynamicResource MkBorder}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,14,0,0">
                    <Border Width="28" Height="28" CornerRadius="7"
                            Background="{DynamicResource MkPrimarySoft}" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconBranch}" Stroke="{DynamicResource MkPrimary}"
                              StrokeThickness="1.8" Stretch="Uniform" Margin="5"/>
                    </Border>
                    <TextBlock Text="Makara" FontSize="18" FontWeight="Bold" Margin="10,0,0,0"
                               Foreground="{DynamicResource MkTextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Text="v0.1.0 · MVP" FontSize="11" Margin="17,4,0,12"
                           Foreground="{DynamicResource MkTextTertiary}"/>

                <!-- 底部：服务端状态 -->
                <Border DockPanel.Dock="Bottom" Margin="12,0,12,12" Padding="10,8" CornerRadius="8"
                        Background="{DynamicResource MkSurface2}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource MkTextTertiary}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ServerOnline}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource MkSuccess}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding CurrentServerName}" FontSize="11" Margin="8,0,0,0"
                                   Foreground="{DynamicResource MkTextSecondary}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 导航 -->
                <StackPanel>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource PageEq}, ConverterParameter=dashboard}"
                                 Command="{Binding NavigateCommand}" CommandParameter="dashboard">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconDashboard}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.6" Stretch="Uniform" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="仪表盘" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource PageEq}, ConverterParameter=workflows}"
                                 Command="{Binding NavigateCommand}" CommandParameter="workflows">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconBranch}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.6" Stretch="Uniform" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="工作流" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource PageEq}, ConverterParameter=datasources}"
                                 Command="{Binding NavigateCommand}" CommandParameter="datasources">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconDatabase}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.6" Stretch="Uniform" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="数据源" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource PageEq}, ConverterParameter=datasets}"
                                 Command="{Binding NavigateCommand}" CommandParameter="datasets">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconTable}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.6" Stretch="Uniform" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="数据集" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource PageEq}, ConverterParameter=runs}"
                                 Command="{Binding NavigateCommand}" CommandParameter="runs">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconActivity}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.6" Stretch="Uniform" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="执行记录" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource PageEq}, ConverterParameter=servers}"
                                 Command="{Binding NavigateCommand}" CommandParameter="servers">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconServer}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.6" Stretch="Uniform" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="服务端" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource PageEq}, ConverterParameter=settings}"
                                 Command="{Binding NavigateCommand}" CommandParameter="settings">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconSettings}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.6" Stretch="Uniform" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="设置" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ==================== 顶栏 ==================== -->
        <Border Grid.Column="1" Grid.Row="0" Background="{DynamicResource MkSurface}"
                BorderBrush="{DynamicResource MkBorder}" BorderThickness="0,0,0,1">
            <DockPanel Margin="24,0,24,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 搜索 -->
                    <Grid Margin="0,0,12,0">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Width="200" Padding="30,6,8,6"/>
                        <Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource MkTextTertiary}"
                              StrokeThickness="1.6" Stretch="Uniform" Width="14" Height="14"
                              HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0" IsHitTestVisible="False"/>
                    </Grid>

                    <!-- 服务端切换 -->
                    <ComboBox ItemsSource="{Binding Servers}" SelectedItem="{Binding CurrentServer}"
                              DisplayMemberPath="Name" MinWidth="130" Margin="0,0,12,0"/>

                    <!-- 主题切换 -->
                    <Button Style="{StaticResource IconButton}" Command="{Binding ToggleThemeCommand}"
                            ToolTip="切换主题" Margin="0,0,12,0">
                        <Path Data="{StaticResource IconSun}" Stroke="{DynamicResource MkTextSecondary}"
                              StrokeThickness="1.6" Stretch="Uniform" Width="16" Height="16">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Data" Value="{StaticResource IconSun}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkTheme}" Value="False">
                                            <Setter Property="Data" Value="{StaticResource IconMoon}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>

                    <!-- 用户 -->
                    <Button Style="{StaticResource IconButton}" ToolTip="用户菜单">
                        <Path Data="{StaticResource IconUser}" Stroke="{DynamicResource MkTextSecondary}"
                              StrokeThickness="1.6" Stretch="Uniform" Width="16" Height="16"/>
                    </Button>
                </StackPanel>

                <TextBlock Text="{Binding PageTitle}" FontSize="16" FontWeight="Medium"
                           Foreground="{DynamicResource MkTextPrimary}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- ==================== 主内容 ==================== -->
        <Grid Grid.Column="1" Grid.Row="1" Margin="24">
            <ContentControl Content="{Binding CurrentView}"/>
        </Grid>
    </Grid>
</Window>
